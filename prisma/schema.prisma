// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Enums
// ============================================================

enum Role {
  ADMIN
  CASHIER
}

enum SaleStatus {
  COMPLETED
  VOIDED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  OTHER
}

// ============================================================
// Auth models (required by Better Auth)
// ============================================================

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          Role      @default(CASHIER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sales             Sale[]
  sessions          Session[]
  accounts          Account[]
  stockAdjustments  StockAdjustment[]
  refunds           Refund[]
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ============================================================
// Product
// ============================================================

model Product {
  id                String   @id @default(cuid())
  name              String
  sku               String?  @unique
  barcode           String?  @unique
  price             Decimal  @db.Decimal(10, 2)
  cost              Decimal? @db.Decimal(10, 2)
  stock             Int      @default(0)
  category          String?
  imageUrl          String?
  lowStockThreshold Int      @default(5)
  active            Boolean  @default(true)
  supplierId        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  saleItems        SaleItem[]
  stockAdjustments StockAdjustment[]
  supplier         Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
}

// ============================================================
// Customer
// ============================================================

enum CustomerType {
  STUDENT
  STAFF
}

model Customer {
  id        String     @id @default(cuid())
  name      String
  type      CustomerType
  schoolId  String?
  staffId   String?
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  sales Sale[]

  @@index([name])
  @@index([schoolId])
  @@index([staffId])
}

// ============================================================
// Sales
// ============================================================

model Sale {
  id             String        @id @default(cuid())
  userId         String
  customerId     String?
  subtotal       Decimal       @db.Decimal(10, 2)
  taxRate        Decimal       @default(0) @db.Decimal(5, 2)
  taxAmount      Decimal       @db.Decimal(10, 2)
  discountAmount Decimal       @default(0) @db.Decimal(10, 2)
  tipAmount      Decimal?      @db.Decimal(10, 2)
  total          Decimal       @db.Decimal(10, 2)
  paymentMethod  PaymentMethod @default(CASH)
  paymentLines   Json?
  amountTendered Decimal?      @db.Decimal(10, 2)
  changeDue      Decimal?      @db.Decimal(10, 2)
  status         SaleStatus    @default(COMPLETED)
  voidReason     String?
  notes          String?
  createdAt      DateTime      @default(now())

  user     User      @relation(fields: [userId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    SaleItem[]
  refunds  Refund[]
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  productId String?
  name      String
  price     Decimal @db.Decimal(10, 2)
  quantity  Int
  total     Decimal @db.Decimal(10, 2)
  notes     String?

  sale    Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

// ============================================================
// Held Orders (POS "Park Sale" feature)
// ============================================================

model HeldOrder {
  id           String   @id @default(cuid())
  label        String?
  cartSnapshot Json
  createdAt    DateTime @default(now())
}

// ============================================================
// Inventory
// ============================================================

enum StockAdjReason {
  RECEIVED
  DAMAGED
  THEFT
  CORRECTION
  OPENING_COUNT
}

model StockAdjustment {
  id        String         @id @default(cuid())
  productId String
  userId    String
  delta     Int
  reason    StockAdjReason
  note      String?
  createdAt DateTime       @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])
}

model Supplier {
  id          String   @id @default(cuid())
  name        String
  contactName String?
  phone       String?
  email       String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
}

// ============================================================
// Refunds
// ============================================================

model Refund {
  id         String   @id @default(cuid())
  saleId     String
  userId     String
  amount     Decimal  @db.Decimal(10, 2)
  reason     String?
  items      Json
  restoreStock Boolean @default(true)
  createdAt  DateTime @default(now())

  sale Sale @relation(fields: [saleId], references: [id])
  user User @relation(fields: [userId], references: [id])
}

// ============================================================
// Business Settings (single-row singleton)
// ============================================================

model BusinessSettings {
  id               String   @id @default("singleton")
  name             String   @default("My Store")
  logoUrl          String?
  primaryColor     String   @default("#0f2044")
  accentColor      String   @default("#f5c518")
  currency         String   @default("$")
  currencyDecimals Int      @default(2)
  taxRate          Decimal  @default(0) @db.Decimal(5, 4)
  taxName          String   @default("Tax")
  receiptFooter    String   @default("Thank you for your purchase!")
  language         String   @default("en")
  // Low-stock
  lowStockThreshold Int     @default(5)
  // Image storage
  storageProvider  String   @default("local")  // local | vercel_blob | cloudflare_r2 | s3
  storageRegion    String?
  storageBucket    String?
  storageEndpoint  String?
  storageAccessKey String?
  storageSecretKey String?
  storagePublicUrl String?
  setupComplete    Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
